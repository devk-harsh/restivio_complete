  "info": {
    "title": "Restivio APIs",
    "version": "1.0.0",
    "description": "Local educational hotel booking backend. JWT access tokens are verified locally. Send X-Correlation-ID to trace a request. Internal endpoints require the service secret and must not be exposed publicly."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "http://localhost:3001"
