  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Service-Key"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "restivio_refresh"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "format": "password"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "HotelInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "ratingCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "address",
          "location"
        ]
      },
      "HotelUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "ratingCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": []
      },
      "CategoryInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "roomType": {
            "type": "string",
            "enum": [
              "SINGLE",
              "DOUBLE",
              "FAMILY",
              "DELUXE",
              "SUITE"
            ]
          },
          "price": {
            "type": "integer",
            "minimum": 1
          },
          "roomCount": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "roomType",
          "price",
          "roomCount"
        ]
      },
      "InventoryRange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "startDate",
          "endDate"
        ]
      },
      "BookingIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hotelId": {
            "type": "integer",
            "minimum": 1
          },
          "roomCategoryId": {
            "type": "integer",
            "minimum": 1
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "numberOfRooms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalGuests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "hotelId",
          "roomCategoryId",
          "checkIn",
          "checkOut",
          "numberOfRooms",
          "totalGuests"
        ]
      },
      "ReservationIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bookingId": {
            "type": "integer",
            "minimum": 1
          },
          "hotelId": {
            "type": "integer",
            "minimum": 1
          },
          "roomCategoryId": {
            "type": "integer",
            "minimum": 1
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "numberOfRooms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "bookingId",
          "hotelId",
          "roomCategoryId",
          "checkIn",
          "checkOut",
          "numberOfRooms"
        ]
      },
      "BookingEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "BOOKING_CONFIRMED",
              "BOOKING_CANCELLED"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bookingId": {
                "type": "integer",
                "minimum": 1
              },
              "hotelId": {
                "type": "integer",
                "minimum": 1
              },
              "userId": {
                "type": "integer",
                "minimum": 1
              },
              "userEmail": {
                "type": "string",
                "format": "email"
              },
              "totalGuests": {
                "type": "integer",
                "minimum": 1
              },
              "bookingAmount": {
                "type": "string",
                "example": "5000.00"
              },
              "checkIn": {
                "type": "string",
                "format": "date",
                "nullable": true
              },
              "checkOut": {
                "type": "string",
                "format": "date",
                "nullable": true
              },
              "numberOfRooms": {
                "type": "integer",
                "minimum": 1,
                "nullable": true
              }
            },
            "required": [
              "bookingId",
              "hotelId",
              "userId",
              "userEmail",
              "totalGuests",
              "bookingAmount",
              "checkIn",
              "checkOut",
              "numberOfRooms"
            ]
          }
        },
        "required": [
          "eventId",
          "type",
          "correlationId",
          "payload"
        ]
      }
    }
  }
}
