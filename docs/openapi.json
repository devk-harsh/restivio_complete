      "post": {
        "summary": "Register a normal USER (role is not accepted)",
        "tags": [
          "auth"
        ],
        "servers": [
          {
            "url": "http://localhost:3000"
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Insufficient role or ownership"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Conflict"
          },
          "503": {
            "description": "Dependency unavailable; retry safely"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        }
      }
    },
