{
  "uid": "restivio-overview",
  "title": "Restivio · Booking & Delivery",
  "tags": [
    "restivio"
  ],
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "restivio-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(restivio_http_requests_total[1m]))",
          "legendFormat": "{{service}}{{outcome}}{{status}}{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP errors / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "restivio-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(restivio_http_errors_total[1m]))",
          "legendFormat": "{{service}}{{outcome}}{{status}}{{state}}"
