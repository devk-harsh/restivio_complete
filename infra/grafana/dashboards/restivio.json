      "datasource": {
        "type": "prometheus",
        "uid": "restivio-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(restivio_http_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}{{outcome}}{{status}}{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
