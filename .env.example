# LOCAL DEMO ONLY. Replace these values for any non-local environment.
JWT_SECRET=restivio-local-demo-jwt-secret-at-least-32-characters
INTERNAL_SERVICE_KEY=restivio-local-internal-service-demo-key
MYSQL_ROOT_PASSWORD=restivio-local-root
DB_PASSWORD=restivio-local-db
GRAFANA_ADMIN_PASSWORD=restivio-local-grafana
SEED_DEMO=true
